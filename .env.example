# Copy to .env and adjust. Never commit .env.
# Everything works with the defaults in dev; only set what you need.

APP_ENV=dev

# --- Identity vault secrets (platform-held, NEVER given to government tenants) ---
# In dev a deterministic fallback is used if these are empty. In prod they are required.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_ENCRYPTION_KEY=
IDENTITY_HASH_PEPPER=

# --- Database / storage passwords (docker-compose) ---
CORE_DB_PASSWORD=core_dev_pw
VAULT_DB_PASSWORD=vault_dev_pw
S3_SECRET_KEY=roadwatch_dev_pw

# --- Vision model ---
# "stub" runs offline with no key. "gemini" uses the Gemini API free tier
# (get a key at https://aistudio.google.com/apikey). Only sanitized photos are sent.
VISION_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional street-level baseline ("none" | "mapillary") ---
STREET_LEVEL_PROVIDER=none
MAPILLARY_TOKEN=
