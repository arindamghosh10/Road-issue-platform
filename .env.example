# Copy to .env and adjust. Never commit .env.
# Everything works with the defaults in dev; only set what you need.

APP_ENV=dev

# --- Identity vault secrets (platform-held, NEVER given to government tenants) ---
# In dev a deterministic fallback is used if these are empty. In prod they are required.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_ENCRYPTION_KEY=
IDENTITY_HASH_PEPPER=
# Signs citizen login tokens.
JWT_SECRET=

# --- Database / storage passwords (docker-compose) ---
CORE_DB_PASSWORD=core_dev_pw
VAULT_DB_PASSWORD=vault_dev_pw
S3_SECRET_KEY=roadwatch_dev_pw

# --- Vision model ---
# "stub" runs offline with no key. "gemini" uses the Gemini API free tier
# (get a key at https://aistudio.google.com/apikey). Only sanitized photos are sent.
VISION_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Verification tuning (defaults shown) ---
# VERIFICATION_THRESHOLD=0.6
# MAX_PHOTO_AGE_HOURS=24
# REQUIRE_ROAD_SNAP=false      # turn on after importing a full OSM road network
# TASKS_EAGER=false            # true = verify inside the upload request (no worker)

# --- Government workflow (defaults shown) ---
# SLA_SWEEP_INTERVAL_S=300     # how often the scheduler checks deadlines
# FIX_PROOF_MAX_DISTANCE_M=50
# CONFIRMATION_WINDOW_DAYS=7
# EMAIL_BACKEND=smtp           # "log" to record emails instead of sending them

# --- Optional street-level baseline ("none" | "mapillary") ---
STREET_LEVEL_PROVIDER=none
MAPILLARY_TOKEN=
